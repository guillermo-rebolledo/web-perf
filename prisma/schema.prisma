generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
  sites         Site[]
}

model Site {
  id        String    @id @default(cuid())
  name      String
  url       String
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  monitors  Monitor[]
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Monitor {
  id                  String               @id @default(cuid())
  siteId              String
  cadenceMinutes      Int                  @default(1440)
  strategy            String               @default("mobile")
  isActive            Boolean              @default(true)
  nextRunAt           DateTime             @default(now())
  lastRunAt           DateTime?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  site                Site                 @relation(fields: [siteId], references: [id], onDelete: Cascade)
  runs                Run[]
  regressionBaselines RegressionBaseline[]

  @@index([siteId])
  @@index([isActive, nextRunAt])
}

model Run {
  id                 String              @id @default(cuid())
  monitorId          String
  status             RunStatus           @default(queued)
  jobId              String?             @unique
  queuedAt           DateTime            @default(now())
  startedAt          DateTime?
  completedAt        DateTime?
  errorMessage       String?
  performanceScore   Float?
  accessibilityScore Float?
  bestPracticesScore Float?
  seoScore           Float?
  lcp                Float?
  inp                Float?
  tbt                Float?
  cls                Float?
  fcp                Float?
  ttfb               Float?
  lighthouseVersion  String?
  finalUrl           String?
  runWarnings        String[]
  speedIndex         Float?
  tti                Float?
  totalByteWeight    Int?
  numRequests        Int?
  mainThreadWork     Float?
  screenshotData     String?

  // Environment & Configuration Metadata
  browserUserAgent      String?
  benchmarkIndex        Float?
  emulatedFormFactor    String?

  // AI-generated summary (cached after first generation)
  aiSummary      String?   @db.Text
  aiSummaryAt    DateTime?
  aiSummaryModel String?

  audits             Audit[]
  insights           Insight[]
  regressionAlerts   RegressionAlert[]
  monitor            Monitor             @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, completedAt])
  @@index([status])
}

model Audit {
  id           String  @id @default(cuid())
  runId        String
  auditId      String
  title        String
  score        Float?
  displayValue String?
  numericValue Float?
  scored       Boolean @default(true)
  details      Json?
  run          Run     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model Insight {
  id            String  @id @default(cuid())
  runId         String
  insightId     String
  title         String
  description   String
  score         Float?
  displayValue  String?
  metricSavings Json?
  sources       Json?
  scored        Boolean @default(false)
  run           Run     @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

enum RunStatus {
  queued
  running
  success
  failed
}

// Regression detection models

model RegressionBaseline {
  id           String   @id @default(cuid())
  monitorId    String
  metricName   String   // "lcp", "tbt", "cls", "inp", "fcp", "ttfb"
  medianValue  Float    // Rolling median value for this metric
  sampleSize   Int      // Number of runs used to calculate baseline
  calculatedAt DateTime @default(now())

  monitor Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@unique([monitorId, metricName])
  @@index([monitorId])
}

model RegressionAlert {
  id             String   @id @default(cuid())
  runId          String
  metricName     String   // "lcp", "tbt", "cls", "inp", "fcp", "ttfb"
  baselineValue  Float    // Baseline median value
  actualValue    Float    // Actual value in this run
  delta          Float    // Absolute difference (actualValue - baselineValue)
  percentChange  Float    // Percentage change ((actualValue - baselineValue) / baselineValue * 100)
  severity       String   // "minor", "moderate", "critical"
  confidence     String   // "low", "medium", "high" (based on consecutive regressions)

  // JSON fields for detailed analysis
  likelyCauses Json? // Array of ranked root causes with evidence
  diffSummary  Json? // Before/after deltas across network/mainThread/rendering/backend

  // Status tracking
  status         String    @default("open") // "open", "acknowledged", "resolved"
  acknowledgedAt DateTime?
  acknowledgedBy String?
  notes          String?   @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([status])
  @@index([severity])
  @@index([createdAt, severity])
  @@index([createdAt, status])
}
