// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../node_modules/.prisma/client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Core application models

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  name          String?
  emailVerified DateTime?
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  sites    Site[]
  accounts Account[]
  sessions Session[]
}

model Site {
  id        String   @id @default(cuid())
  name      String
  url       String
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  monitors Monitor[]

  @@index([userId])
}

model Monitor {
  id             String    @id @default(cuid())
  siteId         String
  cadenceMinutes Int       @default(1440)
  strategy       String    @default("mobile") // "mobile" or "desktop"
  isActive       Boolean   @default(true)
  nextRunAt      DateTime  @default(now())
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  site Site  @relation(fields: [siteId], references: [id], onDelete: Cascade)
  runs Run[]

  @@index([siteId])
  @@index([isActive, nextRunAt])
}

model Run {
  id       String    @id @default(cuid())
  monitorId String
  status    String    @default("queued") // "queued", "running", "success", "failed"
  jobId     String?   @unique
  queuedAt  DateTime  @default(now())
  startedAt DateTime?
  completedAt DateTime?
  errorMessage String?

  // Performance scores (0-100)
  performanceScore   Float?
  accessibilityScore Float?
  bestPracticesScore Float?
  seoScore           Float?

  // Core Web Vitals and metrics (milliseconds or unitless)
  lcp  Float? // Largest Contentful Paint (ms)
  inp  Float? // Interaction to Next Paint (ms)
  tbt  Float? // Total Blocking Time (ms) - fallback if INP not available
  cls  Float? // Cumulative Layout Shift (unitless)
  fcp  Float? // First Contentful Paint (ms)
  ttfb Float? // Time to First Byte (ms)

  // Run metadata
  lighthouseVersion String?
  finalUrl          String?
  runWarnings       String[] // Postgres array

  // Extra performance metrics
  speedIndex      Float? // ms
  tti             Float? // Time to Interactive (ms)
  totalByteWeight Int?   // bytes
  numRequests     Int?   // request count
  mainThreadWork  Float? // ms

  // Screenshot from PageSpeed Insights
  screenshotData String? @db.Text // Base64-encoded JPEG

  audits   Audit[]
  insights Insight[]
  monitor  Monitor @relation(fields: [monitorId], references: [id], onDelete: Cascade)

  @@index([monitorId, completedAt])
  @@index([status])
}

model Audit {
  id           String  @id @default(cuid())
  runId        String
  auditId      String // The audit identifier from PageSpeed Insights
  title        String
  score        Float? // 0-1 scale
  displayValue String?
  numericValue Float?
  scored       Boolean @default(true) // Whether this audit contributes to a category score

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

model Insight {
  id           String  @id @default(cuid())
  runId        String
  insightId    String  // e.g. "image-delivery-insight"
  title        String
  description  String  @db.Text
  score        Float?  // 0-1
  displayValue String?
  scored       Boolean @default(false) // Whether this insight contributes to a category score
  metricSavings Json?  // { LCP: 50, FCP: 0 } — flexible structure
  sources       Json?  // Per-resource details from audit items

  run Run @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
}

// NextAuth models

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}
