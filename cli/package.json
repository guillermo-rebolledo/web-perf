{
  "name": "@perflabs/cli",
  "version": "0.1.0",
  "description": "CLI for Web Performance Lab",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "side": "./dist/index.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
