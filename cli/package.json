    "cac": "^6.7.14",
    "conf": "^13.0.0",
    "ink": "^5.0.1",
    "open": "^10.1.0",
    "picocolors": "^1.1.1",
    "react": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "eslint": "^9",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8",
    "vitest": "^4"
  }
}
