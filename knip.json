{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "workspaces": {
    "cli": {
      "entry": ["src/commands/**/*.{ts,tsx}", "src/**/*.{ts,tsx}"]
    }
  },
  "ignore": [
    "src/components/ui/**",
    "src/types/api.ts"
  ],
  "ignoreDependencies": [
    "postcss"
  ],
  "ignoreExportsUsedInFile": true,
  "playwright": {
    "entry": [
      "e2e/**/*.spec.ts",
      "e2e/auth.setup.ts",
      "e2e/helpers/**/*.ts"
    ]
  },
  "vitest": {
    "entry": [
      "src/**/*.test.{ts,tsx}",
      "src/__tests__/**/*.{ts,tsx}",
      "prisma/**/*.test.ts"
    ]
  }
}
