{
  "name": "side",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.29.2",
  "scripts": {
    "dev": "next dev",
    "dev:worker": "tsx watch src/worker/index.ts",
    "dev:worker:debug-psi": "tsx watch src/worker/index.ts --debug-psi",
    "dev:all": "concurrently \"pnpm dev\" \"pnpm dev:worker\"",
    "dev:all:debug-psi": "concurrently \"pnpm dev\" \"pnpm dev:worker:debug-psi\"",
    "build": "next build",
    "build:worker": "echo 'Worker uses tsx - no build needed'",
    "start": "next start",
    "start:migrate": "prisma migrate deploy && next start",
    "start:worker": "NODE_ENV=production tsx src/worker/index.ts",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "postinstall": "prisma generate",
    "cleanup:screenshots": "node scripts/cleanup-screenshots.js",
    "seed:clean": "tsx prisma/clean-db.ts",
    "seed:regressions": "tsx prisma/seed-regressions.ts",
    "seed:failed-runs": "tsx prisma/seed-failed-runs.ts",
    "cli:build": "pnpm --filter @side/cli build",
    "cli:dev": "pnpm --filter @side/cli dev",
    "cli:lint": "pnpm --filter @side/cli lint",
    "cli:test": "pnpm --filter @side/cli test",
    "cli:test:watch": "pnpm --filter @side/cli test:watch",
    "seed:decline": "tsx prisma/seed-decline.ts",
    "seed:improvement": "tsx prisma/seed-improvement.ts"
  },
  "dependencies": {
    "@ai-sdk/openai": "^3.0.33",
    "@ai-sdk/react": "^3.0.102",
    "@auth/prisma-adapter": "^2.11.1",
    "@hookform/resolvers": "^5.2.2",
    "@prisma/adapter-pg": "^7.4.0",
    "@prisma/client": "^6.19.2",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@t3-oss/env-nextjs": "^0.13.10",
    "ai": "^6.0.100",
    "bullmq": "^5.69.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.3.1",
    "ioredis": "^5.9.3",
    "lucide-react": "^0.564.0",
    "marked": "^17.0.3",
    "nanoid": "^5.1.6",
    "next": "16.1.6",
    "next-auth": "5.0.0-beta.30",
    "next-themes": "^0.4.6",
    "node-cron": "^4.2.1",
    "nodemailer": "^8.0.1",
    "pg": "^8.18.0",
    "posthog-js": "^1.354.2",
    "posthog-node": "^5.26.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "recharts": "^3.7.0",
    "sanitize-html": "^2.17.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.4.1",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^20",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.10",
    "@types/pg": "^8.16.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "@vitejs/plugin-react": "^5.1.4",
    "@vitest/coverage-v8": "^4.0.18",
    "concurrently": "^9.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.1.6",
    "happy-dom": "^20.6.1",
    "prisma": "^6.19.2",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.0.18",
    "vitest-mock-extended": "^3.1.0"
  }
}
