# Database
DATABASE_URL="postgresql://perflab:perflab@localhost:5432/perflab?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-secret-here-generate-with-openssl-rand-base64-32"
# In production with a custom domain, set this to your public URL (e.g. https://perflabs.dev)
NEXTAUTH_URL="http://localhost:3000"

# OAuth Providers
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
GITHUB_CLIENT_ID="your-github-client-id"
GITHUB_CLIENT_SECRET="your-github-client-secret"

# Email magic links via Resend SMTP (optional — only needed if you want passwordless email login)
# https://resend.com/docs/send-with-nextauth-smtp
EMAIL_SERVER_USER=resend
EMAIL_SERVER_PASSWORD=your-resend-api-key
EMAIL_SERVER_HOST=smtp.resend.com
EMAIL_SERVER_PORT=465
EMAIL_FROM=noreply@yourdomain.com

# Redis
REDIS_HOST="localhost"
REDIS_PORT="6379"
REDIS_PASSWORD=""

# PageSpeed Insights API
# Get your API key from: https://developers.google.com/speed/docs/insights/v5/get-started
PAGESPEED_API_KEY="your-pagespeed-api-key-here"

# Scheduler authentication
# Generate with: openssl rand -base64 32
SCHEDULER_SECRET="your-scheduler-secret-here-generate-with-openssl-rand-base64-32"

# Rate limiting
RATE_LIMIT_RUNS_PER_DAY="100"

# Screenshot cleanup (TTL in days)
SCREENSHOT_TTL_DAYS="30"

# Environment
NODE_ENV="development"

# Posthog
NEXT_PUBLIC_POSTHOG_KEY=your-key
NEXT_PUBLIC_POSTHOG_HOST=your-host
NEXT_PUBLIC_POSTHOG_ENABLED=false #Enable this in development if you want to test

# OpenAI
OPENAI_API_KEY=your-key

# Weekly Email Digest (Resend)
# Get your API key from: https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key_here
RESEND_FROM_EMAIL=digest@perflabs.app
# Unsubscribe links use NEXTAUTH_URL (already required above) — no extra var needed
